{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kyber",
  "version": "1.1.0",
  "identifier": "fr.kyber.coffre",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kyber — Coffre-Fort Post-Quantique",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://kyber-security.fr/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQ0YxMzEzQjlDQkE2QzEKUldUQnBzdTVFeFBQLzJ4Qkl5RHNSU3pvNTZwenQwQ1hFSUhMaWEycm9jRUNhVllWR1FHR09GTzkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Coffre-fort post-quantique français",
    "longDescription": "Kyber est le premier gestionnaire de mots de passe post-quantique français. Vos mots de passe sont chiffrés localement avec Kyber1024 + AES-256-GCM + Argon2id. Aucune donnée n'est transmise. Aucun abonnement. Made in France.",
    "publisher": "Kyber Security",
    "copyright": "© 2026 Kyber Security — Made in France",
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "compression": "lzma",
        "startMenuFolder": "Kyber",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "providerShortName": null
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libatspi2.0-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "at-spi2-core"]
      }
    }
  }
}
